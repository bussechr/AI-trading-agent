      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 11,
      "fontFamily": 1,
      "text": "ACTIVATION (build host): default\nflipped\nFalse\u2192True; no new unvalidated\nmodel.\nRUNTIME: the grandfathered live\nset (8/8\nuncertified) can no longer OPEN\npositions\n\u2014 reason `models_uncertified`, in\nthe\noperational set so the adaptive\npolicy\ncannot override it.\nExits/reduces/stops\nstill work, so nothing is\nstranded.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ACTIVATION (build host): default\nflipped\nFalse\u2192True; no new unvalidated\nmodel.\nRUNTIME: the grandfathered live\nset (8/8\nuncertified) can no longer OPEN\npositions\n\u2014 reason `models_uncertified`, in\nthe\noperational set so the adaptive\npolicy\ncannot override it.\nExits/reduces/stops\nstill work, so nothing is\nstranded.",
      "lineHeight": 1.25,
      "autoResize": true
    },
